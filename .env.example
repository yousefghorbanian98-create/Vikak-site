# ── Headless WordPress / WooCommerce (optional) ────────────────────────────
# Leave empty to run the storefront from the bundled catalogue (demo mode).
# When set, prices/stock/images come from WooCommerce and checkout is real.
NEXT_PUBLIC_WP_BASE_URL=
WP_REVALIDATE_SECONDS=300

# ── Sandbox preview host (dev only) ────────────────────────────────────────
# Allows /_next/* assets to load behind the preview proxy.
