# Headless WordPress / WooCommerce (optional)
# Leave empty to run the storefront from the bundled catalogue (demo mode).
# When set, prices/stock/images come from WooCommerce and checkout is real.
NEXT_PUBLIC_WP_BASE_URL=
WP_REVALIDATE_SECONDS=300
# Origins allowed to call the vikak/v1 REST endpoints (comma separated).
VIKAK_STOREFRONT_ORIGINS=

# Public origin of the storefront, e.g. https://vikak.ir
# Used by metadataBase, canonical URLs, sitemap and robots.
# Never hardcode the domain in components: set it here.
NEXT_PUBLIC_SITE_URL=

# Sandbox preview host (dev only). Allows /_next/* assets to load behind the
# preview proxy; keep empty in production.
